{
  "name": "bovada-hud",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "watch": "vite build --watch",
    "watch:firefox": "TARGET_BROWSER=firefox vite build --watch",
    "build": "vite build",
    "build:chrome": "vite build",
    "build:firefox": "TARGET_BROWSER=firefox vite build",
    "run:firefox": "web-ext run --source-dir dist-firefox",
    "lint:firefox": "web-ext lint --source-dir dist-firefox",
    "package:chrome": "npm run build && node scripts/package_store.mjs",
    "package:chrome-sideload": "node scripts/package_store.mjs chrome-sideload",
    "package:firefox": "node scripts/package_store.mjs firefox",
    "package:firefox:verify": "node scripts/package_store.mjs firefox --verify",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-web-extension": "^4.1.1",
    "vitest": "^4.1.10",
    "web-ext": "^10.7.0"
  }
}
