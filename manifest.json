{
  "manifest_version": 3,
  "name": "WebPokerHud",
  "version": "1.0.1",
  "description": "Live poker HUD with real-time stats and hand-history analytics for your browser.",
  "{{chrome}}.key": "",
  "{{firefox}}.browser_specific_settings": {
    "gecko": {
      "id": "webpokerhud@webpokerhud.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["authenticationInfo", "websiteContent"]
      }
    }
  },
  "permissions": [
    "storage",
    "downloads",
    "unlimitedStorage",
    "identity"
  ],
  "{{chrome}}.host_permissions": [
    "https://www.bovada.lv/*",
    "http://localhost/*",
    "https://api.webpokerhud.com/*"
  ],
  "{{firefox}}.host_permissions": [
    "https://www.bovada.lv/*",
    "https://api.webpokerhud.com/*"
  ],
  "{{chrome}}.background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "{{firefox}}.background": {
    "scripts": ["src/background.ts"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bovada.lv/*"
      ],
      "js": [
        "src/injected.ts"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.bovada.lv/*"
      ],
      "js": [
        "src/content_script.ts"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "WebPokerHud",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/panel/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
